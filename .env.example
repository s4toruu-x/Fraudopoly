# Copy this file to .env.local (and .env.production for builds) and fill it in.
# The game runs on Supabase, so it needs these. See "Server setup" in the README.

# Supabase project URL and anon (or publishable) key, from Project Settings > API.
# 640K's project works too: Fraudopoly's tables and functions have their own names.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
